# Copy this file to ".env" in the backend/ folder and fill in real values.
# The app runs fine without this file too - everything has safe defaults,
# except real email/SMS alerts (those get simulated/printed instead).

# --- Email alerts (Gmail example - use an App Password, not your real password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
ALERT_FROM_EMAIL=your-email@gmail.com

# --- SMS alerts via Twilio (optional, Phase 8) ---
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Forecast (optional, Phase 7) ---
OPENWEATHER_API_KEY=

# --- Paths (only change if you moved files around) ---
MODEL_PATH=../model/landslide_model.pkl
DATABASE_PATH=landslide_app.db

# --- CORS (optional) ---
# Leave unset/blank for "*" (fine for local dev with a static-file frontend).
# For a real deployment, set to your frontend's actual origin(s), comma-separated:
# ALLOWED_ORIGINS=https://your-frontend-domain.com
ALLOWED_ORIGINS=
